# Medusa Environment Variables
# Copy this to .env and fill in your values

# Database
POSTGRES_DB=medusa
POSTGRES_USER=medusa
POSTGRES_PASSWORD=your_secure_password_here

# Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here
COOKIE_SECRET=your_cookie_secret_here

# CORS (comma-separated URLs)
# Your storefront URLs
STORE_CORS=https://your-store.com,http://localhost:8000
# Admin dashboard URL (usually same as backend)
ADMIN_CORS=https://medusajs.psmhome.no
# Auth CORS (admin + storefront)
AUTH_CORS=https://medusajs.psmhome.no,https://your-store.com

# Backend URL (public URL of your Medusa backend)
BACKEND_URL=https://medusajs.psmhome.no

# Port (default 9000)
MEDUSA_PORT=9000

# Optional: S3/MinIO File Storage
# S3_FILE_URL=https://your-bucket.s3.amazonaws.com
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_REGION=us-east-1
# S3_BUCKET=medusa-files
# S3_ENDPOINT=https://s3.amazonaws.com  # or MinIO endpoint

# ================================================
# INTEGRATIONS (to be configured)
# ================================================

# Razorpay Payment Gateway (@alchemilla/medusa-razorpay)
# All 4 vars are REQUIRED — missing any one prevents the provider from loading.
#
# RAZORPAY_ID             — API Key ID (rzp_test_... or rzp_live_...)
# RAZORPAY_SECRET         — API Key Secret (from Razorpay Dashboard > API Keys)
# RAZORPAY_ACCOUNT        — Account/Merchant ID (acc_XXXXXXXXXXXXX, from Dashboard > Settings > Account & Billing)
# RAZORPAY_WEBHOOK_SECRET — Webhook Secret (set when creating a webhook in Dashboard > Settings > Webhooks)
#
# STOREFRONT_URL is used by the /razorpay/callback route to redirect the customer
# back to the storefront order confirmation page after payment signature verification.
# Without it, successful payments redirect to localhost:8000 (broken in production).
#
RAZORPAY_ID=
RAZORPAY_SECRET=
RAZORPAY_ACCOUNT=
RAZORPAY_WEBHOOK_SECRET=
STOREFRONT_URL=https://your-storefront.com

# Google OAuth
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_CALLBACK_URL=https://medusajs.psmhome.no/auth/google/callback

# Facebook OAuth
# FACEBOOK_CLIENT_ID=your_facebook_app_id
# FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
# FACEBOOK_CALLBACK_URL=https://medusajs.psmhome.no/auth/facebook/callback

# ShipRocket Fulfillment
# SHIPROCKET_EMAIL      — Your ShipRocket login email
# SHIPROCKET_PASSWORD   — Your ShipRocket login password
# SHIPROCKET_TEST_MODE  — When "true", shows courier rates but requires
#                         confirmation before creating actual shipments
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_TEST_MODE=true

# n8n Event Forwarding
# All Medusa events are forwarded to n8n via Redis pub/sub (channel: medusa:events)
# AND via webhook POST as a fallback. Both channels deliver the same payload.
#
# N8N_WEBHOOK_URL    — Internal Docker URL to n8n webhook endpoint
#                      (e.g., http://n8n:5678/webhook/medusa-events)
# N8N_WEBHOOK_SECRET — Shared secret for webhook authentication
#                      (n8n verifies this in the X-Webhook-Secret header)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
