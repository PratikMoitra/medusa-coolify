# WooCommerce -> Medusa Migration Environment Variables
# Copy this to .env and fill in your values before running the migration.
# Tip: any variable set here will be used as a default — the script will
# prompt for anything left blank.

# ── Medusa Backend ─────────────────────────────────────────────────
MEDUSA_BACKEND_URL=https://medusajs.psmhome.no
MEDUSA_ADMIN_EMAIL=admin@yourstore.com
MEDUSA_ADMIN_PASSWORD=

# ── WooCommerce Source ─────────────────────────────────────────────
# Generate REST API keys from: WooCommerce > Settings > Advanced > REST API
WOOCOMMERCE_URL=https://chamkileystore.in
WOOCOMMERCE_CONSUMER_KEY=ck_
WOOCOMMERCE_CONSUMER_SECRET=cs_

# ── Cloudflare R2 (image deduplication) ────────────────────────────
# These are used to HEAD-check if an image already exists in R2 before
# downloading from WooCommerce and re-uploading via Medusa.
# Without these, the script still works but cannot skip already-uploaded images
# unless they are in the local migration-images-cache.json.
# Get these from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.yourstore.com
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Inventory ──────────────────────────────────────────────────────
# Default stock quantity to set per variant when WooCommerce stock
# data is unavailable (manage_stock=false or stock_quantity is null).
# If left blank, the script will prompt; pressing Enter defaults to 500.
DEFAULT_INVENTORY_QTY=500
